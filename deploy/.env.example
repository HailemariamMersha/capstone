# Server-only values. Never copy DATABASE_URL or service_role into a mobile/web build.
DATABASE_URL=postgresql+psycopg://skymeasure_api.PROJECT_REF:REPLACE@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/skymeasure/certs/supabase-prod-ca-2021.crt&options=-csearch_path%3Dskymeasure%2Cpg_catalog
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_KEY
# Required only by the identity deletion worker/management command:
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_ONLY
DASHBOARD_ORIGINS=https://dashboard.example.org
API_DOMAIN=api.example.org
PROBE_REGION=fra1
# Legacy sync is disabled unless explicitly set to 1 for local development.
CAPSTONE_LOCAL_DEV=0
