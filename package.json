{
  "name": "LabPracticeApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "reference:bundle": "node scripts/build-ndt7-assets.cjs",
    "reference:test-browser": "node scripts/test-ndt7-browser.cjs",
    "postinstall": "patch-package --error-on-fail && npm run reference:bundle",
    "measurements:analyze": "node --experimental-strip-types scripts/measurements/analyze.cjs",
    "measurements:docs": "node scripts/measurements/dictionary.cjs",
    "skymeasure:configure": "node scripts/configure-skymeasure.cjs",
    "skymeasure:docs": "node scripts/skymeasure-docs.cjs"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.40.3",
    "@m-lab/ndt7": "0.1.5",
    "@noble/hashes": "2.4.0",
    "@op-engineering/op-sqlite": "18.2.3",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/material-design-icons": "14.0.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@supabase/supabase-js": "2.118.0",
    "buffer": "6.0.3",
    "fast-text-encoding": "1.0.6",
    "ping-react-native": "2.1.1",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-background-actions": "4.1.0",
    "react-native-background-fetch": "4.4.2",
    "react-native-device-info": "15.0.2",
    "react-native-get-random-values": "2.0.0",
    "react-native-inappbrowser-reborn": "3.7.1",
    "react-native-keychain": "10.0.0",
    "react-native-paper": "5.15.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.30.0",
    "react-native-share": "12.3.1",
    "react-native-tcp-socket": "6.4.3",
    "react-native-udp": "4.1.7",
    "react-native-url-polyfill": "4.0.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
