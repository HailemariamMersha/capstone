# Public mobile configuration only. Copy to .env.skymeasure.local.
# Never put database passwords, service-role keys or OAuth secrets here.
SKYMEASURE_SUPABASE_URL=https://PROJECT_REF.supabase.co
SKYMEASURE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
SKYMEASURE_API_URL=https://api.example.invalid
SKYMEASURE_PROBE_URL=https://api.example.invalid
SKYMEASURE_UDP_IPV4=192.0.2.1
SKYMEASURE_PROBE_REGION=lab-location-unconfirmed
# The pilot builder selects its own registered callback automatically.
SKYMEASURE_REDIRECT_URL=com.labpracticeapp.flightpilot://auth/callback
# Configure protected anonymous enrollment before public recruitment.
SKYMEASURE_ENROLLMENT_URL=
